# Local runtime configuration only. GitHub Actions reads repository Secrets.
# Use fictitious placeholders; never commit real values or reuse a UIS password.
StuId=your_student_id
UISPsw=your_uis_password

# Dedicated database encryption key (generate with: openssl rand -hex 32)
# Never reuse the UIS password here.
DB_ENCRYPTION_KEY=your_random_64_hex_character_key

# Course IDs to monitor (comma-separated)
COURSE_IDS=

# Optional private plaintext/encrypted glossary path. Local default is ignored by Git.
COURSE_GLOSSARY_PATH=

# Optional private schedule allowlist (one course per line).
# Courses omitted here keep all playable lectures.
COURSE_SESSION_RULES=
COURSE_SESSION_EXCLUSIONS=
# Optional date overrides; comma-separated dates, e.g. YYYY-MM-DD,YYYY-MM-DD.
COURSE_SESSION_OVERRIDE_DATES=

# ModelScope LLM API key
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Optional endpoint overrides; blank keeps provider defaults in config.py.
DASHSCOPE_BASE_URL=
DEEPSEEK_BASE_URL=
GEMINI_BASE_URL=
DOUBAO_ASR_API_KEY=
TAVILY_API_KEY=

# QQ SMTP (use authorization code, not login password)
SMTP_EMAIL=
SMTP_PASSWORD=
RECEIVER_EMAILS=
# Legacy single-recipient fallback when RECEIVER_EMAILS is empty.
RECEIVER_EMAIL=

# Storage (optional, defaults shown)
DATA_DIR=data
DB_PATH=data/icourse.db

# Qwen3-ASR-1.7B model/revision are pinned in code; sherpa-onnx is VAD only.
SILERO_VAD_PATH=silero_vad.onnx
ASR_NUM_THREADS=4
USE_OFFICIAL_TRANSCRIPT=0
IMAGE_WORKERS=20
OCR_MAX_WORKERS=8
OCR_MAX_TARGET=2
VIDEO_DOWNLOAD_CONCURRENCY=2

# SHARD_MODE, AUTO_COURSE_TERMS, PUBLISH_RESULTS and SEND_EMAIL are workflow
# inputs, not GitHub Secrets. Frontend PAT is session-only, not configured here.
